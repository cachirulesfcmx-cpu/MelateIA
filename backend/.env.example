# Backend configuration — copy to .env and adjust for your environment.

# SQLite (local/dev). For PostgreSQL/production use e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/melateai
DATABASE_URL=sqlite:///./melateai.db

# Change this to a long random string in production
SECRET_KEY=change-me-in-production-melateai-pro-secret

# Comma-separated allowed origins, or * for all
CORS_ORIGINS=*
