# Frontend configuration.
# In dev the Vite proxy forwards /api -> http://127.0.0.1:8000 (see vite.config.ts),
# so VITE_API_URL can stay as the default "/api".
# For a separately hosted backend set the full URL, e.g.:
# VITE_API_URL=https://your-backend.example.com/api
VITE_API_URL=/api

# Optional: override the dev proxy target
# VITE_API_TARGET=http://127.0.0.1:8000
